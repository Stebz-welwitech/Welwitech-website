---
import type { Image } from "../types";

interface Props {
  images: Image[];
  direction?: 1 | -1;
  label?: string;
}

const { images, direction, label } = Astro.props;
---

<div class="logo-band">
  <div class="u-container band-inner">
    {label ? <p class="label u-text">{label}</p> : null}

    <div class="track">
      <sy-image-marquee data-dir={direction}>
        <div class="inner">
          {
            images.map((img) => (
              <div class="img">
                <img {...img} loading="lazy" decoding="async" />
              </div>
            ))
          }
        </div>
      </sy-image-marquee>

      <div class="fade fade-left" aria-hidden="true"></div>
      <div class="fade fade-right" aria-hidden="true"></div>
    </div>
  </div>
</div>

<style>
  .logo-band {
    width: 100%;
    padding: 1.5rem 0 var(--section-gap, 5rem);
  }

  .band-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;

    @media (--mq-tablet-sm) {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  .label {
    --fs: var(--font-size-xs);
    --fw: 500;
    flex-shrink: 0;
    max-width: 9rem;
    text-align: right;
    color: var(--color-text-alt);
    letter-spacing: 0.01em;
    line-height: 1.3;
    padding-right: 1.5rem;
    border-right: 1px solid var(--hairline);

    @media (--mq-tablet-sm) {
      max-width: none;
      text-align: center;
      padding-right: 0;
      border-right: none;
    }
  }

  .track {
    position: relative;
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  sy-image-marquee {
    display: block;
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: 0.75rem 0;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;

    :global(&.is-ready) {
      opacity: 1;
    }
  }

  .inner {
    display: grid;
    gap: 3.5rem;

    @media (--mq-tablet-sm) {
      gap: 2rem;
    }
  }

  .img {
    grid-row: 1;
    grid-column: 1;
    transform: translateZ(0);
    will-change: transform;
    width: 6rem;
    height: 2.25rem;
    filter: grayscale(1);
    opacity: 0.5;
    transition: filter 0.4s var(--ease-out-cubic), opacity 0.4s var(--ease-out-cubic);

    &:hover {
      filter: grayscale(0);
      opacity: 1;
    }

    @media (--mq-tablet-sm) {
      width: 8rem;
      height: 3rem;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }

  /* edge fades — mimics the progressive blur of the reference */
  .fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 5rem;
    pointer-events: none;
    z-index: 2;
  }

  .fade-left {
    left: 0;
    background: linear-gradient(to right, var(--color-bg), rgba(var(--rgb-white), 0));
  }

  .fade-right {
    right: 0;
    background: linear-gradient(to left, var(--color-bg), rgba(var(--rgb-white), 0));
  }

  :global([data-theme="dark"]) .img {
    filter: grayscale(1) invert(1) brightness(1.6);
    opacity: 0.55;

    &:hover {
      filter: invert(1) brightness(1.6);
      opacity: 1;
    }
  }

  :global([data-theme="dark"]) .fade-left {
    background: linear-gradient(to right, var(--color-bg), rgba(15, 15, 19, 0));
  }

  :global([data-theme="dark"]) .fade-right {
    background: linear-gradient(to left, var(--color-bg), rgba(15, 15, 19, 0));
  }
</style>

<script>
  import { addResizeObserver } from "../utils/observers";
  import { addIntersectingTicker } from "../utils/globalTicker";

  import { gsap } from "gsap";

  class ImageMarquee extends HTMLElement {
    x = 0;
    width = -1;
    direction = 1;
    ghosts: HTMLElement[] = [];
    images: HTMLElement[] = [];
    wrap!: (n: number) => number;

    constructor() {
      super();

      this.images = Array.from(this.querySelectorAll(".img")) as HTMLElement[];
      this.direction = Number(this.dataset.dir) || 1;

      addResizeObserver(this);
      addIntersectingTicker(this);
    }

    connectedCallback() {
      this.reCalc();

      this.classList.add("is-ready");
    }

    onWidthResize() {
      this.reCalc();
    }

    reCalc() {
      const { images } = this;

      const inner = this.querySelector(".inner")!;

      const fbcr = images[0].getBoundingClientRect();
      const gap = parseInt(window.getComputedStyle(inner).columnGap, 10);

      const width = Math.floor(fbcr.width + gap);

      this.width = width;

      this.fillScreen();

      this.wrap = gsap.utils.wrap(-width, width * (this.images.length - 1));

      this.x = Math.round(1000 * -this.direction * Math.random());
    }

    fillScreen() {
      const images = this.images;
      const width = this.width;
      const innerWidth = window.innerWidth * 2;
      const inner = this.querySelector(".inner")!;

      this.ghosts.forEach((g) => {
        const index = images.indexOf(g);
        images.splice(index, 1);

        g.remove();
      });

      this.ghosts = [];
      const ghosts = this.ghosts;

      const fillCount = Math.floor(innerWidth / width);

      if (images.length < fillCount) {
        for (let i = 0; i < fillCount - images.length; i++) {
          const clone = images[i % images.length].cloneNode(
            true,
          ) as HTMLElement;

          clone.ariaHidden = "true";
          ghosts.push(clone);
          images.push(clone);
        }

        inner.append(...ghosts);
      }

      this.images = images;
    }

    tick() {
      const dir = this.direction;

      this.x -=
        (Math.min(Math.abs(window.scrollVelocity) * 0.4, 10) + 0.5) *
        (window.scrollDirection || 1) *
        dir;

      const images = this.images;
      const width = this.width;
      const x = this.x;
      const wrap = this.wrap;

      images.forEach((item, i) => {
        const xx = wrap(x + width * i);

        item.style.transform = `translateX(${xx}px)`;
      });
    }
  }

  customElements.define("sy-image-marquee", ImageMarquee);
</script>
