---
import Button from "../components/Button.astro";
import type { Link } from "../types";

interface Props {
  title: string;
  text: string;
  cta?: Link;
}

const { title, text, cta } = Astro.props;
---

<div class="sy-introducing">
  <div class="u-container container">
    <div class="inner">
      <h2 class="u-heading title" data-sy-reveal="words">{title}</h2>
      <p class="u-text" data-sy-reveal="lines">
        {text}
      </p>
      {cta ? <Button {...cta} arrow class="cta" /> : null}
      <div data-gl-place></div>
    </div>
  </div>
</div>

<style>
  .container {
    margin-bottom: var(--section-gap);
    position: relative;
  }

  .inner {
    position: relative;
    z-index: 9;
    max-width: 52rem;
    margin: 0 auto;
    padding: 3.5rem 2.5rem;
    text-align: center;
    gap: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    border: 1px solid rgba(var(--rgb-brand-1), 0.12);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    background:
      radial-gradient(90% 130% at 85% 8%, rgba(var(--rgb-brand-5), 0.16), transparent 55%),
      linear-gradient(160deg, var(--color-brand-3) 0%, var(--color-bg) 72%);
    backdrop-filter: blur(6px) saturate(1.05);

    @media (--mq-phone) {
      padding: 2.5rem 1.5rem;
    }
  }

  h2 {
    --fs: clamp(1.6rem, 3.5vw, 3rem);
    --lh: 1.1;
    max-width: 20em;
  }

  p {
    max-width: 38em;
    color: var(--color-text-alt);
    line-height: 1.65;
  }

  [data-gl-place] {
    --d: 0.1;
    --s: 14rem;
    position: absolute;
    right: 0%;
    top: 0;
    margin-top: -2rem;

    @media (--mq-tablet-sm) {
      transform: translateX(-10%);
      left: 0;
    }
  }
</style>
